{
    "name": "Form Builder",
    "slug": "form-builder",
    "version": "1.1.0",
    "author": "RJ CMS",
    "author_url": "https://github.com/mr-ruhid",
    "plugin_url": "https://github.com/mr-ruhid/rj-plugin-form-builder",
    "description": "Create, manage, and embed forms. Includes RJBuilder widget and admin panel.",
    "license": "MIT",
    "main": "src/Plugin.php",
    "namespace": "RjPlugins\\FormBuilder",
    "provider": "RjPlugins\\FormBuilder\\FormBuilderServiceProvider",

    "requires": {
        "rj_cms": ">=1.0.0",
        "php": ">=8.2"
    },

    "provides": {
        "admin_menu": [
            {
                "id": "forms",
                "title": "Forms",
                "icon": "clipboard-list",
                "route": "admin.plugin.forms.index",
                "position": 30
            }
        ],
        "widgets": [
            "RjPlugins\\FormBuilder\\Widgets\\FormWidget"
        ],
        "routes": {
            "admin": "routes/admin.php",
            "frontend": "routes/frontend.php"
        },
        "views": "views",
        "migrations": "src/Migrations",
        "assets": "assets"
    },

    "update_url": "https://raw.githubusercontent.com/mr-ruhid/rj-plugin-form-builder/main/plugin.json"
}