{
    "name": "RJ Commerce",
    "slug": "rj-commerce",
    "version": "1.0.0",
    "author": "RJ Nexus",
    "author_url": "https://github.com/rj-nexus",
    "plugin_url": "https://github.com/rj-nexus/rj-plugin-commerce",
    "description": "A complete e-commerce solution for RJ CMS. Manage products, orders, and storefronts.",
    "license": "MIT",
    "main": "src/Plugin.php",
    "namespace": "RjCommerce",
    "provider": "RjCommerce\\Providers\\CommerceServiceProvider",
    "requires": {
        "rj_cms": ">=1.0.0",
        "php": ">=8.2"
    },
    "provides": {
        "admin_menu": [
            {
                "id": "commerce",
                "title": "Commerce",
                "icon": "shopping-cart",
                "route": "admin.commerce.products.index",
                "position": 25
            }
        ],
        "routes": {
            "admin": "routes/admin.php",
            "frontend": "routes/web.php"
        },
        "views": "resources/views",
        "migrations": "database/migrations"
    },
    "update_url": "https://raw.githubusercontent.com/rj-nexus/rj-plugin-commerce/main/plugin.json"
}
