{
    "name": "RJ Default",
    "slug": "rj-default",
    "version": "1.0.0",
    "author": "RJ CMS",
    "author_url": "https://github.com/mr-ruhid",
    "description": "The official default theme for RJ CMS. Clean, minimal, builder-first.",
    "license": "MIT",
    "screenshot": "screenshot.png",
    "requires": {
        "rj_cms": ">=1.0.0",
        "php": ">=8.2"
    },
    "supports": {
        "builder_header": true,
        "builder_footer": true,
        "builder_page": true,
        "builder_popup": true,
        "custom_logo": true,
        "custom_colors": true,
        "custom_fonts": true,
        "post_thumbnail": true,
        "post_excerpt": true,
        "menus": ["header", "footer", "mobile"]
    },
    "views": {
        "layout": "views/layout.blade.php",
        "single_post": "views/single-post.blade.php",
        "single_page": "views/single-page.blade.php",
        "archive": "views/archive.blade.php"
    },
    "custom_templates": [
        {
            "id": "contact",
            "label": "Contact Page",
            "description": "Two-column layout with contact form and info sidebar.",
            "view": "views/templates/contact.blade.php",
            "icon": "mail"
        },
        {
            "id": "landing",
            "label": "Landing Page",
            "description": "Full-width hero with centered CTA. No sidebar.",
            "view": "views/templates/landing.blade.php",
            "icon": "rocket"
        },
        {
            "id": "full-width",
            "label": "Full Width",
            "description": "Edge-to-edge content without container padding.",
            "view": "views/templates/full-width.blade.php",
            "icon": "expand"
        }
    ],
    "assets": {
        "css": [],
        "js": []
    }
}